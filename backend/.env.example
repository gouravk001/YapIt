# Used by dev.sh to start uvicorn.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Relative paths are resolved against the backend folder.
DATABASE_PATH=./yapit.db
CONFIG_DIR=./config

# Browser origins allowed to call the API (JSON list). Must include the frontend's URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Largest audio upload accepted, in megabytes.
MAX_UPLOAD_MB=25
